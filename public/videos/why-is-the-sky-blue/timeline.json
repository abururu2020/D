          "cueFound": true
        }
      ]
    },
    {
      "start": 7.474674556213007,
      "end": 15.396094674556283,
      "narration": "White light is really every color mixed together. Each color is a wave, and blue waves are much shorter than red ones.",
      "visual": "A rainbow splitting out of white light, then short blue waves beside long red waves.",
      "elements": [
        {
          "label": "",
          "cue": "color",
          "kind": "emoji",
          "text": "🌈",
          "at": 9.131479289940831,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "mixed",
          "kind": "headline",
          "text": "Every color",
          "at": 9.486508875739652,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "shorter",
          "kind": "bullet",
          "text": "Blue = short waves",
          "at": 13.685147928994136,
          "cueFound": true
        }
      ]
    },
    {
      "start": 15.396094674556283,
      "end": 22.910828402366835,
      "narration": "In our atmosphere, that light runs into tiny nitrogen and oxygen molecules, far smaller than the waves themselves.",
      "visual": "The Earth's atmosphere with tiny molecules floating in it.",
      "elements": [
        {
          "label": "",
          "cue": "atmosphere",
          "kind": "emoji",
          "text": "🌍",
          "at": 15.81029585798824,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "nitrogen",
          "kind": "bullet",
          "text": "Nitrogen",
          "at": 18.23881656804738,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "oxygen",
          "kind": "bullet",
          "text": "Oxygen",
          "at": 19.008047337278136,
          "cueFound": true
        }
      ]
    },
    {
      "start": 22.910828402366835,
      "end": 32.31153846153829,
      "narration": "Those molecules scatter short waves far more than long ones. It's called Rayleigh scattering, and blue scatters about five times more than red.",
      "visual": "Light bouncing off molecules in every direction, with a big 5x stat.",
      "elements": [
        {
          "label": "",
          "cue": "scatter",
          "kind": "emoji",
          "text": "💥",
          "at": 23.857573964496996,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "Rayleigh",
          "kind": "headline",
          "text": "Rayleigh scattering",
          "at": 27.580355029585697,
          "cueFound": true
        },
        {
          "label": "more scattering for blue",
          "cue": "five",
          "kind": "stat",
          "text": "5x",
          "at": 30.423076923076774,
          "cueFound": true
        }
      ]
    },
    {
      "start": 32.31153846153829,
      "end": 37.5727810650888,
      "narration": "So blue light bounces all over the sky and reaches your eyes from every direction.",
      "visual": "Blue light arriving at a pair of eyes from all around.",
      "elements": [
        {
          "label": "",
          "cue": "eyes",
          "kind": "emoji",
          "text": "👀",
          "at": 35.62514792899405,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "direction",
          "kind": "bullet",
          "text": "From every direction",
          "at": 36.57189349112427,
          "cueFound": true
        }
      ]
    },
    {
      "start": 37.5727810650888,
      "end": 45.733372781065434,
      "narration": "Violet scatters even more, so why not a purple sky? The sun sends less violet, and our eyes are more sensitive to blue.",
      "visual": "A purple sky that fades back to blue.",
      "elements": [
        {
          "label": "",
          "cue": "Violet",
          "kind": "emoji",
          "text": "💜",
          "at": 37.5727810650888,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "purple",
          "kind": "headline",
          "text": "Why not purple?",
          "at": 40.11964497041434,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "sensitive",
          "kind": "bullet",
          "text": "Our eyes favor blue",
          "at": 44.2591124260358,
          "cueFound": true
        }
      ]
    },
    {
      "start": 45.733372781065434,
      "end": 55.108571,
      "narration": "At sunset, light crosses so much air that the blue scatters away, leaving reds and oranges. Same physics, different sky.",
      "visual": "A warm orange sunset, ending on the takeaway line.",
      "elements": [
        {
          "label": "",
          "cue": "sunset",
          "kind": "emoji",
          "text": "🌅",
          "at": 45.91088757396485,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "away",
          "kind": "bullet",
          "text": "Blue scatters away",
          "at": 49.46366863905375,
          "cueFound": true
        },
        {
          "label": "",
          "cue": "physics",
          "kind": "headline",
          "text": "Same physics, different sky",
          "at": 52.18301775147988,
          "cueFound": true
        }
      ]
    }
  ]
