# Copy this file to .env and fill in your values.  .env is gitignored.

# --- ElevenLabs (voice + per-word timings) ---------------------------------
# Leave these empty to use MOCK mode: a silent track with estimated timings,
# useful for designing the look without spending credits.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Claude (writes the script) ---------------------------------------------
# Optional. Without it, the pipeline reads a hand-written script from
# scripts/<topic-slug>.json instead.
ANTHROPIC_API_KEY=

# --- Optional: point Remotion at an existing Chrome/Chromium binary ---------
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
